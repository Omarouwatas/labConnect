    {
      "id": "file:frontend-client/src/api.js",
      "type": "file",
      "name": "api.js",
      "filePath": "frontend-client/src/api.js",
      "summary": "Central REST client for the labConnect mobile app: auto-detects the backend URL from Expo host metadata, manages JWT tokens in AsyncStorage with an in-memory cache, handles 401 token refresh, and exports typed functions for auth, labs, appointments, nurse visits, notifications, and PDF retrieval.",
      "tags": ["service", "api-handler", "utility"],
      "complexity": "complex",
      "languageNotes": "Token management uses a write-through memory cache (_access, _refresh) to avoid repeated AsyncStorage reads on parallel fetch calls. The rawFetch function automatically retries once after refreshing the access token on a 401 response."
    },
    {
      "id": "class:frontend-client/src/api.js:ApiError",
      "type": "class",
      "name": "ApiError",
      "filePath": "frontend-client/src/api.js",
      "lineRange": [85, 90],
      "summary": "Custom error class extending Error, carrying structured API error details: HTTP status, error code, human-readable detail, and the raw response body.",
      "tags": ["utility", "service"],
      "complexity": "simple"
    },
