    {
      "id": "file:frontend-client/src/biometric.js",
      "type": "file",
      "name": "biometric.js",
      "filePath": "frontend-client/src/biometric.js",
      "summary": "Low-level biometric authentication helpers bridging expo-local-authentication, expo-secure-store, and expo-crypto: generates a stable device ID, inspects hardware capability, triggers OS biometric prompt, and manages SecureStore persistence of the device token and phone.",
      "tags": ["service", "authentication", "security"],
      "complexity": "complex",
      "languageNotes": "Device token is stored with WHEN_UNLOCKED_THIS_DEVICE_ONLY to prevent extraction even when the phone is PIN-unlocked without biometric confirmation. The biometric prompt itself is the gating mechanism, not SecureStore requireAuthentication."
    },
