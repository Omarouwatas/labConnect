      "complexity": "complex"
    },
    {
      "id": "file:frontend-client/src/screens/nurse/NurseValidateScreen.js",
      "type": "file",
      "name": "NurseValidateScreen.js",
      "filePath": "frontend-client/src/screens/nurse/NurseValidateScreen.js",
      "summary": "Nurse visit closure screen with visit summary, PanResponder-based finger-signature canvas (no external SVG dep), and a confirm button that calls completeVisit() to finalize the appointment.",
      "tags": ["component", "screen", "nurse-flow"],
      "complexity": "complex",
      "languageNotes": "Signature is captured as an array of {x, y} points rendered as absolutely positioned Views rather than using react-native-svg, keeping dependencies minimal."
