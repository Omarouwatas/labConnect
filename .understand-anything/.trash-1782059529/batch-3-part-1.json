  "nodes": [
    {
      "id": "file:frontend-client/App.js",
      "type": "file",
      "name": "App.js",
      "filePath": "frontend-client/App.js",
      "summary": "Root application component for the React Native mobile client, defining the full navigation tree with role-based shells: a patient tab navigator (Home, Bookings, Profile) and a nurse tab navigator (Route, Profile), wrapped in AuthProvider and NavigationContainer.",
      "tags": ["entry-point", "component", "navigation", "role-based-routing"],
      "complexity": "complex",
      "languageNotes": "Uses React Navigation's createNativeStackNavigator and createBottomTabNavigator. Role selection via pickRoleShell switches the whole shell at runtime. Custom font loading (Fredoka + Nunito) is handled before first render to avoid font flash."
    },
    {
      "id": "function:frontend-client/App.js:MainTabs",
      "type": "function",
      "name": "MainTabs",
      "filePath": "frontend-client/App.js",
