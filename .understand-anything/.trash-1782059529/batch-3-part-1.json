    {
      "id": "file:frontend-client/src/screens/BookingsScreen.js",
      "type": "file",
      "name": "BookingsScreen.js",
      "filePath": "frontend-client/src/screens/BookingsScreen.js",
      "summary": "Patient screen displaying appointments and test results via a segmented tab (Rendez-vous / Résultats), with navigation to ResultDetailScreen on result tap.",
      "tags": ["component", "screen", "api-handler"],
      "complexity": "complex"
    },
    {
      "id": "file:frontend-client/src/screens/CartScreen.js",
      "type": "file",
      "name": "CartScreen.js",
      "filePath": "frontend-client/src/screens/CartScreen.js",
      "summary": "Appointment booking screen with date/slot picker, mode toggle (lab vs home visit), CNAM coverage breakdown, prerequisite questionnaire, GPS capture, and animated confirmation overlay after successful booking.",
      "tags": ["component", "screen", "api-handler", "booking"],
      "complexity": "complex",
      "languageNotes": "Uses CommonActions.reset to navigate back to the Bookings tab after booking, avoiding Expo SDK 54 navigation crashes that would occur with a direct navigate call."
    },
    {
      "id": "file:frontend-client/src/screens/HomeScreen.js",
      "type": "file",
      "name": "HomeScreen.js",
      "filePath": "frontend-client/src/screens/HomeScreen.js",
      "summary": "Main patient home screen with unified lab + analysis search (name, city, analysis code), distance/category/CNAM/home-visit filters, a mini Leaflet map (260 px), and a full lab list sorted by relevance.",
      "tags": ["component", "screen", "api-handler", "search"],
      "complexity": "complex"
    },
    {
      "id": "file:frontend-client/src/screens/LabDetailScreen.js",
      "type": "file",
      "name": "LabDetailScreen.js",
      "filePath": "frontend-client/src/screens/LabDetailScreen.js",
      "summary": "Lab detail screen showing hero banner, rating, distance, CNAM status, test catalog with category filters, and a sticky footer to navigate to CartScreen with selected tests.",
      "tags": ["component", "screen", "api-handler"],
      "complexity": "complex"
    },
    {
      "id": "file:frontend-client/src/components/LabMapView.js",
      "type": "file",
      "name": "LabMapView.js",
      "filePath": "frontend-client/src/components/LabMapView.js",
      "summary": "Shared React Native component embedding a Leaflet map in a WebView, supporting lab markers, animated user location, lab popup press callbacks, and both mini-card and fullscreen layout modes.",
      "tags": ["component", "map", "utility"],
      "complexity": "complex",
      "languageNotes": "Uses injectJavaScript to push lab/user updates to the WebView instead of reloading HTML, avoiding Leaflet tile refetch on every re-render. Leaflet tile sizes are also force-invalidated on layout to work around react-native-webview sizing bugs on iOS and Android."
    },
    {
      "id": "function:frontend-client/src/components/LabMapView.js:LabMapView",
      "type": "function",
      "name": "LabMapView",
      "filePath": "frontend-client/src/components/LabMapView.js",
      "lineRange": [30, 123],
      "summary": "Default-exported component that manages a WebView with embedded Leaflet map, synchronizing lab markers and user location via injected JS and exposing an onLabPress callback.",
      "tags": ["component", "map"],
      "complexity": "complex"
    },
    {
      "id": "function:frontend-client/src/components/LabMapView.js:buildHtml",
      "type": "function",
      "name": "buildHtml",
      "filePath": "frontend-client/src/components/LabMapView.js",
      "lineRange": [125, 283],
      "summary": "Generates the full Leaflet HTML string embedded in the WebView, including OSM tiles, CSS marker styles, lab and user marker rendering functions, and invalidateSize hacks.",
      "tags": ["utility", "map"],
      "complexity": "complex"
    },
    {
      "id": "file:frontend-client/src/screens/LoginScreen.js",
      "type": "file",
      "name": "LoginScreen.js",
      "filePath": "frontend-client/src/screens/LoginScreen.js",
      "summary": "Unified login screen supporting email/password, OTP phone flow, Google OAuth, and biometric (Face ID / fingerprint) authentication, with last-identifier prefill and biometric opt-in prompt after first OTP login.",
      "tags": ["component", "screen", "authentication"],
      "complexity": "complex",
      "languageNotes": "Implements a three-step flow (id → pwd or otp → success) driven by a `step` state. Uses expo-auth-session for Google OAuth and bioStore check before triggering OS biometric prompt."
    },
